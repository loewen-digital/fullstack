{
  "name": "@loewen-digital/fullstack",
  "version": "0.4.0",
  "description": "Backend primitives for any JavaScript meta-framework",
  "homepage": "https://github.com/loewen-digital/fullstack#readme",
  "bugs": {
    "url": "https://github.com/loewen-digital/fullstack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loewen-digital/fullstack.git"
  },
  "bin": {
    "fullstack": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./auth/flatdb": {
      "import": "./dist/auth/adapters/flatdb.js",
      "types": "./dist/auth/adapters/flatdb.d.ts"
    },
    "./db": {
      "import": "./dist/db/index.js",
      "types": "./dist/db/index.d.ts"
    },
    "./session": {
      "import": "./dist/session/index.js",
      "types": "./dist/session/index.d.ts"
    },
    "./security": {
      "import": "./dist/security/index.js",
      "types": "./dist/security/index.d.ts"
    },
    "./mail": {
      "import": "./dist/mail/index.js",
      "types": "./dist/mail/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./logging": {
      "import": "./dist/logging/index.js",
      "types": "./dist/logging/index.d.ts"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "types": "./dist/errors/index.d.ts"
    },
    "./queue": {
      "import": "./dist/queue/index.js",
      "types": "./dist/queue/index.d.ts"
    },
    "./events": {
      "import": "./dist/events/index.js",
      "types": "./dist/events/index.d.ts"
    },
    "./notifications": {
      "import": "./dist/notifications/index.js",
      "types": "./dist/notifications/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./search": {
      "import": "./dist/search/index.js",
      "types": "./dist/search/index.d.ts"
    },
    "./permissions": {
      "import": "./dist/permissions/index.js",
      "types": "./dist/permissions/index.d.ts"
    },
    "./webhooks": {
      "import": "./dist/webhooks/index.js",
      "types": "./dist/webhooks/index.d.ts"
    },
    "./realtime": {
      "import": "./dist/realtime/index.js",
      "types": "./dist/realtime/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./adapters/sveltekit": {
      "import": "./dist/adapters/sveltekit/index.js",
      "types": "./dist/adapters/sveltekit/index.d.ts"
    },
    "./adapters/nuxt": {
      "import": "./dist/adapters/nuxt/index.js",
      "types": "./dist/adapters/nuxt/index.d.ts"
    },
    "./adapters/remix": {
      "import": "./dist/adapters/remix/index.js",
      "types": "./dist/adapters/remix/index.d.ts"
    },
    "./adapters/astro": {
      "import": "./dist/adapters/astro/index.js",
      "types": "./dist/adapters/astro/index.d.ts"
    },
    "./adapters/fetch": {
      "import": "./dist/adapters/fetch/index.js",
      "types": "./dist/adapters/fetch/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "scripts": {
    "build": "vp pack && node scripts/smoke-dist.mjs",
    "prepublishOnly": "npm run build",
    "dev": "vp pack --watch",
    "check": "vp check",
    "format": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "bench": "vp test bench",
    "size": "node scripts/bundle-size.mjs",
    "docs:api": "typedoc",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@loewen-digital/flatdb": "^0.2.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "svelte": "^5.57.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.7.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@loewen-digital/flatdb": "^0.2.1",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependenciesMeta": {
    "@loewen-digital/flatdb": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "engines": {
    "node": "24"
  }
}
