#!/bin/sh
# Pre-push hook: runs check (format, lint, types) and tests before every push.
# Installed automatically via the "prepare" npm script.
# To skip in an emergency: git push --no-verify

set -e

echo "⏳ Running pre-push checks..."

echo "\n▶ check"
npm run check

echo "\n▶ test"
npm run test

echo "\n✅ All checks passed."
